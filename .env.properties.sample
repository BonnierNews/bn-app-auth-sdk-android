# Copy this file to .env.properties (git-ignored) and fill in your environment's values
# to run the example app. Without .env.properties the app is built with these dummy values.
EXAMPLE_ISSUER=https://oidc-provider.com/
EXAMPLE_CLIENT_ID=client-id
EXAMPLE_LOGIN_REDIRECT_URL=custom.redirect.scheme://www.test.se/login
EXAMPLE_LOGOUT_REDIRECT_URL=custom.redirect.scheme://www.test.se/logout
EXAMPLE_TRANSFER_TOKEN_RESOURCE=https://www.example.com/
